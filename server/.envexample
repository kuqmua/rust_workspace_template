ADMIN_ACCESS_TOKEN_TTL_SECONDS="900"
ADMIN_COOKIE_SECURE="false"
ADMIN_JWT_SECRET="replace-with-at-least-32-random-bytes"
ADMIN_PASSWORD_HASH_CONCURRENCY="4"
ADMIN_REFRESH_TOKEN_TTL_SECONDS="2592000"
ADMIN_SESSION_LIMIT="20"
ADMIN_SIGN_IN_RATE_LIMIT="10"
ADMIN_SWAGGER_ENABLED="true"
ADMIN_TOKEN_AUDIENCE="rust-workspace-template-admin"
ADMIN_TOKEN_ISSUER="rust-workspace-template"
CORS_ALLOW_ORIGIN="http://127.0.0.1:8080,http://localhost:8080" # comma-separated origins, e.g. "http://127.0.0.1:8080,https://example.com"
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; frame-ancestors 'none'"
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/postgres"
ENABLE_API_GIT_COMMIT_CHECK="true"
HTTP_GZIP_ENABLED="true"
MAXIMUM_SIZE_OF_HTTP_BODY_IN_BYTES="1048576000" # 100 megabyte in bytes
PG_POOL_MAX_CONNECTIONS="50"
PG_POOL_MIN_CONNECTIONS="1"
PG_POOL_ACQUIRE_TIMEOUT_SECONDS="10"
PG_POOL_IDLE_TIMEOUT_SECONDS="600"
PG_POOL_MAX_LIFETIME_SECONDS="1800"
SERVICE_SOCKET_ADDRESS="127.0.0.1:8080"
SRC_PLACE_TYPE="src" # src|github
TIMEZONE="10800" # i32, in seconds. main is 10800. value = hours * 3600. -24 < hours < 24. so value is -86_400 < secs && secs < 86_400. Otherwise panics on start.  Makes a new FixedOffset for the Eastern Hemisphere with given timezone difference. The negative secs means the Western Hemisphere
TRACING_LEVEL="debug" # trace|debug|info|warn|er
TRACING_FORMAT="text" # text|json
TRUSTED_PROXY_RANGES_TEXT="127.0.0.1/32,::1/128"
